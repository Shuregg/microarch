        <mxCell id="31" value="&lt;b&gt;[S1] CHECK_TAG&lt;br&gt;&lt;/b&gt;&lt;br&gt;Tag comparison&amp;nbsp; (ways_hits)&lt;br&gt;cache_hit = |ways_hits&lt;br&gt;s1_is_miss = s1_valid &amp;amp;&amp;amp; !cache_hit&lt;br&gt;Victim select (invalid / max lru_age)&lt;br&gt;Compute new_state_cell_hit&lt;br&gt;Compute new_state_cell_miss&lt;br&gt;Port B write on hit (when s1_advancing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=center;glass=0;strokeWidth=2;dashed=1;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="470" y="230" width="212" height="220" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;b&gt;[S2] REFILL&lt;br&gt;&lt;/b&gt;&lt;br&gt;Hit: pass-through (1 cycle)&lt;br&gt;Miss: wait ext_mem_ack_i&lt;br&gt;On ack: write cache_sram (refill)&lt;br&gt;On ack: Port B write (miss LRU)&lt;br&gt;ext_mem_req_o pulse from S1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=center;glass=0;strokeWidth=2;dashed=1;arcSize=5;" parent="1" vertex="1">
