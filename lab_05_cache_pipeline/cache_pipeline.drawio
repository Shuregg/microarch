        <mxCell id="30" value="&lt;b&gt;[S0] CACHE_REQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=bottom;align=center;fillStyle=auto;dashed=1;fillColor=none;strokeColor=#6c8ebf;glass=0;strokeWidth=2;arcSize=3;labelPosition=center;verticalLabelPosition=top;" parent="1" vertex="1">
